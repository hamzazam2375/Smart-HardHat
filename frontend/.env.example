# Copy to frontend/.env.local. Never commit real values.

# Signs the session cookie. Required in production (32+ characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Dev only: shared password for the mock accounts (default: hardhat-demo).
# Mock sign-in is disabled in production builds unless this is set.
MOCK_SIGNIN_PASSWORD=
